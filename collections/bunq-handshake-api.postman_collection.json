              "raw": "{\n  \"description\": \"<string>\",\n  \"secret\": \"<string>\",\n  \"permitted_ips\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
