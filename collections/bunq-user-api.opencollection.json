{
  "opencollection": "1.0.0",
  "info": {
    "name": "bunq Public Attachment User API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Bunq-Client-Authentication",
      "value": "{{X-Bunq-Client-Authentication}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users for the session",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bunq.com/v1/user"
          },
          "docs": "Lists the user object(s) accessible in the current session."
        },
        {
          "info": {
            "name": "Get a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bunq.com/v1/user/:userID",
            "params": [
              {
                "name": "userID",
                "value": "",
                "type": "path",
                "description": "The numeric ID of the user."
              }
            ]
          },
          "docs": "Retrieves a single user (UserPerson, UserCompany, or UserPaymentServiceProvider) by ID."
        }
      ]
    }
  ],
  "bundled": true
}